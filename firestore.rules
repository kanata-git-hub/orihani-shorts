rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kanata840@gmail.com' && request.auth.token.email_verified == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /approved_users/{userId} {
      allow read, write: if isAdmin();
    }
    
    match /history/{docId} {
      allow read, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
      allow create: if isAdmin() || (request.auth != null && request.resource.data.userId == request.auth.uid);
    }
    
    match /media/{docId} {
      allow read, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
      allow create: if isAdmin() || (request.auth != null && request.resource.data.userId == request.auth.uid);
    }
  }
}
